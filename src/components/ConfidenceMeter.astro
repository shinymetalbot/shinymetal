---
interface Props { value: number; compact?: boolean }
const v = Math.max(0, Math.min(100, Math.round(+Astro.props.value || 0)));
const word = v >= 80 ? "Very likely" : v >= 60 ? "Likely" : v >= 40 ? "Plausible" : v >= 20 ? "Thin" : "Speculative";
---
<div class="fd-meter" role="meter" aria-valuenow={v} aria-valuemin="0" aria-valuemax="100" aria-label="Rumor confidence">
  <div class="fd-meter-head"><span class="fd-meter-word">{word}</span><span class="fd-num fd-meter-val">{v}<small>/100</small></span></div>
  <div class:list={["fd-meter-track", v < 40 && "fd-meter-low"]}><span class="fd-meter-fill" style={`width:${v}%`}></span>{[1, 2, 3, 4].map((i) => <i style={`left:${i * 20}%`}></i>)}</div>
  {!Astro.props.compact && <div class="fd-meter-scale"><span>Speculative</span><span>Thin</span><span>Plausible</span><span>Likely</span><span>Very likely</span></div>}
</div>
