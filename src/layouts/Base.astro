---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
interface Props { title: string; description: string; image?: string | null; type?: "website" | "article"; jsonLd?: object | object[]; noindex?: boolean }
const { title, description, image, type = "website", jsonLd, noindex } = Astro.props;
const fullTitle = title === "ShinyMetal" ? "ShinyMetal — the owner's manual for the robot age" : `${title} · ShinyMetal`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", "https://shinymetal.bot").toString();
const ogImage = image ?? new URL("/og-default.png", "https://shinymetal.bot").toString();
const ga = process.env.GA4_ID ?? "";
const ld = [
  { "@context": "https://schema.org", "@type": "Organization", name: "ShinyMetal", url: "https://shinymetal.bot", logo: "https://shinymetal.bot/favicon.svg", sameAs: ["https://x.com/shinymetalbot"] },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ShinyMetal" href="/rss.xml" />
    <meta property="og:site_name" content="ShinyMetal" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@shinymetalbot" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15161b" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("sm-theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", ga);
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="hp" style="position:absolute">Skip to content</a>
    <SiteHeader />
    <main id="main" class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
