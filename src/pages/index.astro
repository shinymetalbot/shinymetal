---
import Base from "../layouts/Base.astro";
import ArticleHeader from "../components/ArticleHeader.astro";
import ArticleItem from "../components/ArticleItem.astro";
import StoryCard from "../components/StoryCard.astro";
import RobotCard from "../components/RobotCard.astro";
import Figure from "../components/Figure.astro";
import PromiseTimeline from "../components/PromiseTimeline.astro";
import StatusBadge from "../components/StatusBadge.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import ClaimLabel from "../components/ClaimLabel.astro";
import { q, api } from "../lib/convex";
import { fmtDate, CLAIMS, type ClaimKind } from "../lib/format";

const [articles, robots, promises, events] = await Promise.all([
  q(api.articles.listPublished, { limit: 20 }),
  q(api.robots.list, {}),
  q(api.promises.list, {}),
  q(api.robots.recentEvents, { limit: 8 }),
]);
const lead = articles[0];
const latest = articles.slice(1, 7);
const more = articles.slice(7, 10);
const FOLLOW = ["tesla-optimus", "1x-neo", "figure-03", "unitree-g1", "unitree-r1", "agility-digit", "boston-dynamics-atlas", "xpeng-iron"];
const follow = FOLLOW.map((s) => robots.find((r) => r.slug === s)).filter(Boolean).slice(0, 4);
// Promise ledger teaser: the company with the most logged claims, newest five
const byCo = promises.reduce<Record<string, typeof promises>>((acc, p) => ((acc[p.company] ??= []).push(p), acc), {});
const topCo = Object.entries(byCo).sort((a, b) => b[1].length - a[1].length)[0];
const leadVideo = lead?.heroVideoUrl ?? null;
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300");
---
<Base title="ShinyMetal" description="Independent news, specs and a record of every promise in humanoid and home robots. Every claim labeled shipped, preorder, promise, rumor or research.">
  <div class="home-top">
    {lead ? (
      <section class="lead-story" aria-label="Lead story">
        <a href={`/news/${lead.slug}`} class="card-link" tabindex="-1" aria-hidden="true">
          <Figure src={lead.heroUrl} video={leadVideo} alt="" caption={lead.heroCaption} ratio="wide" eager />
        </a>
        <ArticleHeader a={lead} level="h2" lead href={`/news/${lead.slug}`} />
      </section>
    ) : <div class="empty">The first stories are on their way.</div>}
    <aside>
      <h2 class="section-title" style="margin-top:0"><span>Latest</span><a href="/news">All news</a></h2>
      <ul class="fd-list" style="margin:0">{latest.map((a) => <ArticleItem a={a} />)}</ul>
    </aside>
  </div>

  <h2 class="section-title"><span>Robots to follow</span><a href="/robots">All {robots.length} robots</a></h2>
  <div class="grid-cards four rail-sm">{follow.map((r, i) => <RobotCard robot={r} shade={(i % 4) + 1} />)}</div>

  <div class="two-col">
    <section>
      <h2 class="section-title"><span>Reality tracker</span><a href="/tracker">Full tracker</a></h2>
      <ul class="fd-list" style="margin:0">
        {events.map((e) => (
          <li class="fd-list-item">
            <div class="fd-list-top"><StatusBadge status={e.status} /><span class="fd-list-meta">{fmtDate(e.date)}</span></div>
            <h3 class="fd-list-title" style="font-size:18px;line-height:22px"><a href={`/robots/${e.robotSlug}`} style="text-decoration:none">{e.robotName}</a></h3>
            <p style="margin:0;font-size:15px;line-height:22px;color:var(--ink-2)">{e.note} <a class="sm-link" href={e.sourceUrl} rel="noopener" target="_blank">Source</a></p>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2 class="section-title"><span>Promise ledger</span><a href="/promises">Every promise</a></h2>
      {topCo && <PromiseTimeline company={topCo[0]} href={`/promises#${topCo[0].toLowerCase().replace(/[^a-z0-9]+/g, "-")}`} items={topCo[1].slice(-5)} />}
    </section>
  </div>

  {more.length > 0 && (
    <>
      <h2 class="section-title"><span>More stories</span><a href="/news">All news</a></h2>
      <div class="grid-cards three rail-sm">{more.map((a, i) => <StoryCard a={a} shade={(i % 4) + 1} />)}</div>
    </>
  )}

  <h2 class="section-title"><span>How we label claims</span><a href="/about#labels">Why</a></h2>
  <ul class="legend">
    {(Object.keys(CLAIMS) as ClaimKind[]).map((k) => <li><span><ClaimLabel kind={k} /></span><span>{CLAIMS[k].help}</span></li>)}
  </ul>

  <div style="margin-top:var(--space-8)"><NewsletterForm source="home" /></div>
</Base>
