---
const path = Astro.url.pathname;
const NAV = [
  ["News", "/news"],
  ["Robots", "/robots"],
  ["Compare", "/compare"],
  ["Tracker", "/tracker"],
  ["Promises", "/promises"],
  ["About", "/about"],
];
const active = (href: string) => path === href || path.startsWith(href + "/");
---
<header class="site-head" data-head>
  <div class="wrap inner">
    <a class="site-brand" href="/" aria-label="ShinyMetal home">
      <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true"><circle cx="32" cy="32" r="30" fill="var(--metal-bright)"/><path d="M14 21 A21 21 0 0 1 22.5 12.8" fill="none" stroke="var(--surface)" stroke-width="2" stroke-linecap="round"/><text x="32" y="45" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="38" fill="var(--on-metal)">S</text></svg>
      <span class="name">Shiny<span>Metal</span></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {NAV.map(([label, href]) => <a href={href} aria-current={active(href) ? "page" : undefined}>{label}</a>)}
    </nav>
    <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch color theme">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="icon-btn menu-btn" data-menu aria-label="Menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav class="mobile-nav wrap" aria-label="Mobile">
    {NAV.map(([label, href]) => <a href={href} aria-current={active(href) ? "page" : undefined}>{label}</a>)}
    <a href="/newsletter">Newsletter</a>
  </nav>
</header>
<script>
  const head = document.querySelector<HTMLElement>("[data-head]")!;
  const btn = head.querySelector<HTMLButtonElement>("[data-menu]")!;
  btn.addEventListener("click", () => {
    const open = head.toggleAttribute("data-open");
    btn.setAttribute("aria-expanded", String(open));
  });
  head.querySelector("[data-theme-toggle]")!.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("sm-theme", next); } catch {}
  });
</script>
